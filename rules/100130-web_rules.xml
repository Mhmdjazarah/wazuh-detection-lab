<!--
  Wazuh Detection Engineering Lab - Web server (Apache / Nginx access logs)
  Rule ID range: 100130 - 100139
  Author: Mohamad Al Jazarah
-->
<group name="detection_lab,web,">

  <!-- DL-WEB-001: SQL injection patterns in the URL -->
  <rule id="100130" level="12">
    <if_group>web</if_group>
    <url type="pcre2">(?i)(union(\s|%20|\+|/\*\*/)+(all(\s|%20|\+)+)?select|(%27|')(\s|%20|\+)*or(\s|%20|\+)*(%27|')?1(%27|')?(\s|%20|\+)*=(\s|%20|\+)*(%27|')?1|sleep(\s|%20)*\(\d+\)|benchmark\(|information_schema|xp_cmdshell)</url>
    <description>[DL-WEB-001] SQL injection attempt from $(srcip): $(url)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>attack,sql_injection,</group>
  </rule>

  <!-- DL-WEB-002: Path traversal / LFI -->
  <rule id="100131" level="10">
    <if_group>web</if_group>
    <url type="pcre2">(?i)(\.\.\/|\.\.\\|%2e%2e(%2f|%5c|/)|\.\.%2f|%252e%252e)+.*(etc\/passwd|etc\/shadow|win\.ini|boot\.ini|proc\/self)</url>
    <description>[DL-WEB-002] Path traversal / LFI attempt from $(srcip): $(url)</description>
    <mitre>
      <id>T1190</id>
      <id>T1083</id>
    </mitre>
    <group>attack,path_traversal,</group>
  </rule>

  <!-- DL-WEB-003: Web shell command execution -->
  <rule id="100132" level="13">
    <if_group>web</if_group>
    <url type="pcre2">(?i)\.(php|asp|aspx|jsp)\?(cmd|exec|command|c)=(whoami|id|uname|cat|ls|dir|net|powershell|bash|nc|wget|curl)</url>
    <description>[DL-WEB-003] Possible web shell command execution from $(srcip): $(url)</description>
    <mitre>
      <id>T1505.003</id>
    </mitre>
    <group>attack,web_shell,</group>
  </rule>

  <!-- DL-WEB-004: Known offensive scanner user-agent -->
  <rule id="100133" level="8">
    <if_group>web</if_group>
    <match type="pcre2">(?i)"[^"]*(sqlmap|nikto|nuclei|gobuster|dirbuster|wpscan|masscan|zgrab|feroxbuster)[^"]*"$</match>
    <description>[DL-WEB-004] Offensive scanner user-agent from $(srcip)</description>
    <mitre>
      <id>T1595.002</id>
    </mitre>
    <group>recon,scanner,</group>
  </rule>

</group>
