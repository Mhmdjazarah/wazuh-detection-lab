<!--
  Wazuh Detection Engineering Lab - Windows (Sysmon + Security channel)
  Rule ID range: 100110 - 100129
  Author: Mohamad Al Jazarah
  Requires: Sysmon (e.g. SwiftOnSecurity / olafhartong config) + Wazuh agent collecting
            Microsoft-Windows-Sysmon/Operational and Security channels.
-->
<group name="detection_lab,windows,">

  <!-- ===================== EXECUTION ===================== -->

  <!-- DL-WIN-001: PowerShell with encoded command -->
  <rule id="100110" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s-(e|ec|en|enc|enco|encodedcommand)\s+[A-Za-z0-9+/=]{20,}</field>
    <description>[DL-WIN-001] PowerShell executed a Base64 encoded command on $(win.system.computer)</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1027</id>
    </mitre>
    <group>execution,</group>
  </rule>

  <!-- DL-WIN-002: Office application spawning a shell / script host -->
  <rule id="100111" level="13">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\(winword|excel|powerpnt|outlook|onenote)\.exe$</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32)\.exe$</field>
    <description>[DL-WIN-002] Office app $(win.eventdata.parentImage) spawned $(win.eventdata.image) - possible malicious macro</description>
    <mitre>
      <id>T1566.001</id>
      <id>T1204.002</id>
    </mitre>
    <group>initial_access,execution,</group>
  </rule>

  <!-- DL-WIN-003: certutil used to download a remote file (LOLBin) -->
  <rule id="100112" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)certutil(\.exe)?.+-(urlcache|verifyctl).+https?://</field>
    <description>[DL-WIN-003] certutil used to download a file from the internet (LOLBin)</description>
    <mitre>
      <id>T1105</id>
      <id>T1218</id>
    </mitre>
    <group>command_and_control,defense_evasion,</group>
  </rule>

  <!-- ===================== PERSISTENCE ===================== -->

  <!-- DL-WIN-004: Scheduled task created from the command line -->
  <rule id="100113" level="9">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)schtasks(\.exe)?\s+.*\/create</field>
    <description>[DL-WIN-004] Scheduled task created via schtasks on $(win.system.computer)</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
    <group>persistence,</group>
  </rule>

  <!-- DL-WIN-005: Registry Run key modified -->
  <rule id="100114" level="10">
    <if_group>sysmon_event_13</if_group>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\Software\\Microsoft\\Windows\\CurrentVersion\\(Run|RunOnce)\\</field>
    <description>[DL-WIN-005] Registry Run key set by $(win.eventdata.image) - possible persistence</description>
    <mitre>
      <id>T1547.001</id>
    </mitre>
    <group>persistence,</group>
  </rule>

  <!-- DL-WIN-006: Local user created from the command line -->
  <rule id="100115" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)net1?(\.exe)?\s+user\s+\S+\s+\S*\s*\/add</field>
    <description>[DL-WIN-006] Local user account created via net user /add</description>
    <mitre>
      <id>T1136.001</id>
    </mitre>
    <group>persistence,account_changed,</group>
  </rule>

  <!-- ===================== CREDENTIAL ACCESS ===================== -->

  <!-- DL-WIN-007: Known credential dumping tools / techniques in the command line -->
  <rule id="100116" level="14">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(sekurlsa::|lsadump::|mimikatz|procdump(64)?(\.exe)?\s.*-ma\s.*lsass|comsvcs(\.dll)?.*minidump)</field>
    <description>[DL-WIN-007] Credential dumping tool or technique detected on $(win.system.computer)</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <group>credential_access,</group>
  </rule>

  <!-- DL-WIN-008: Brute force followed by a successful logon from the same IP -->
  <rule id="100117" level="13" frequency="5" timeframe="300">
    <if_group>authentication_success</if_group>
    <if_matched_group>authentication_failed</if_matched_group>
    <field name="win.system.channel">^Security$</field>
    <same_field>win.eventdata.ipAddress</same_field>
    <description>[DL-WIN-008] Windows logon SUCCESS from $(win.eventdata.ipAddress) after multiple failures - possible compromised account</description>
    <mitre>
      <id>T1110</id>
      <id>T1078</id>
    </mitre>
    <group>authentication_success,brute_force,compromise,</group>
  </rule>

  <!-- ===================== DISCOVERY ===================== -->

  <!-- DL-WIN-009a: Single discovery command (low level, used for correlation) -->
  <rule id="100118" level="3">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(\bwhoami\b|\bsysteminfo\b|\bipconfig\s+\/all|\bnet1?(\.exe)?\s+(user|group|localgroup)\b|\bnltest\b|\bquser\b|\btasklist\b)</field>
    <description>[DL-WIN-009a] Discovery command executed: $(win.eventdata.commandLine)</description>
    <mitre>
      <id>T1082</id>
      <id>T1087</id>
    </mitre>
    <group>discovery,</group>
  </rule>

  <!-- DL-WIN-009b: Burst of discovery commands on the same host -->
  <rule id="100119" level="10" frequency="4" timeframe="120" ignore="300">
    <if_matched_sid>100118</if_matched_sid>
    <same_field>win.system.computer</same_field>
    <description>[DL-WIN-009b] Burst of 4+ discovery commands on $(win.system.computer) - possible hands-on-keyboard attacker</description>
    <mitre>
      <id>T1082</id>
      <id>T1087</id>
    </mitre>
    <group>discovery,</group>
  </rule>

  <!-- ===================== IMPACT ===================== -->

  <!-- DL-WIN-010: Shadow copy deletion / recovery disabled (ransomware precursor) -->
  <rule id="100120" level="15">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(vssadmin(\.exe)?\s+delete\s+shadows|wmic(\.exe)?\s+shadowcopy\s+delete|bcdedit(\.exe)?.+recoveryenabled\s+no|wbadmin(\.exe)?\s+delete\s+catalog)</field>
    <description>[DL-WIN-010] Shadow copies deleted or recovery disabled - RANSOMWARE precursor on $(win.system.computer)</description>
    <mitre>
      <id>T1490</id>
    </mitre>
    <group>impact,ransomware,</group>
  </rule>

  <!-- ===================== DEFENSE EVASION ===================== -->

  <!-- DL-WIN-011: Security audit log cleared (event 1102).
       Built-in rule 60117 alerts at level 9 but maps it to T1070.004 (File Deletion);
       clearing the event log is T1070.001 (Clear Windows Event Logs). -->
  <rule id="100121" level="12">
    <if_group>logs_cleared</if_group>
    <field name="win.system.channel">^Security$</field>
    <field name="win.system.eventID">^1102$</field>
    <description>[DL-WIN-011] Security audit log CLEARED on $(win.system.computer) - possible anti-forensics</description>
    <mitre>
      <id>T1070.001</id>
    </mitre>
    <group>defense_evasion,</group>
  </rule>

  <!-- DL-WIN-012: Event log cleared from the command line -->
  <rule id="100122" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(wevtutil(\.exe)?"?\s+(cl|clear-log)\s|Clear-EventLog|Remove-EventLog|GlobalSession\.ClearLog)</field>
    <description>[DL-WIN-012] Windows event log cleared from the command line: $(win.eventdata.commandLine)</description>
    <mitre>
      <id>T1070.001</id>
    </mitre>
    <group>defense_evasion,</group>
  </rule>

  <!-- ===================== LATERAL MOVEMENT ===================== -->

  <!-- DL-WIN-013: PsExec-style remote execution service installed (System event 7045).
       Built-in 61138 only says "New Windows Service Created" (level 5). -->
  <rule id="100123" level="12">
    <if_group>windows_system</if_group>
    <field name="win.system.eventID">^7045$</field>
    <field name="win.eventdata.imagePath" type="pcre2">(?i)(psexesvc|paexec|remcom|csexec|%comspec%|cmd(\.exe)?\s+\/c|powershell|\\\\(127\.0\.0\.1|localhost)\\\w+\$|\\admin\$\\)</field>
    <description>[DL-WIN-013] Remote-execution service installed on $(win.system.computer): $(win.eventdata.serviceName) -> $(win.eventdata.imagePath)</description>
    <mitre>
      <id>T1569.002</id>
      <id>T1021.002</id>
    </mitre>
    <group>lateral_movement,execution,</group>
  </rule>

  <!-- DL-WIN-014: Remote command execution via WMI / WinRM / PsExec from the command line -->
  <rule id="100124" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(wmic(\.exe)?"?\s+.*\/node:\s*\S+.*process\s+call\s+create|Invoke-(Command|WmiMethod|CimMethod)\s+.*-ComputerName\s+\S+|winrs(\.exe)?"?\s+.*-r(emote)?:\S+|(ps|pa)exec(64)?(\.exe)?"?\s+.*\\\\\S+)</field>
    <description>[DL-WIN-014] Remote command execution (WMI / WinRM / PsExec) from $(win.system.computer): $(win.eventdata.commandLine)</description>
    <mitre>
      <id>T1047</id>
      <id>T1021.006</id>
      <id>T1021.002</id>
    </mitre>
    <group>lateral_movement,execution,</group>
  </rule>

  <!-- ===================== COLLECTION / EXFILTRATION ===================== -->

  <!-- DL-WIN-015: Data staged into a password-protected archive (7-Zip / RAR) -->
  <rule id="100125" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\b(7z|7za|7zr|7zg|rar|winrar)(\.exe)?"?\s+a\s+(\S+\s+)*-h?p\S*</field>
    <description>[DL-WIN-015] Data staged in a password-protected archive: $(win.eventdata.commandLine)</description>
    <mitre>
      <id>T1560.001</id>
    </mitre>
    <group>collection,</group>
  </rule>

  <!-- DL-WIN-016: Exfiltration to cloud storage / web upload with command-line tools.
       rclone remotes need 2+ characters before ":" so local drive letters (D:\) do not match. -->
  <rule id="100126" level="13">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(rclone(\.exe)?"?\s+(copy|copyto|sync|move|moveto)\s+.*\s[\w-]{2,}:|curl(\.exe)?"?\s(.*\s)?(-T\s|--upload-file\s|-F\s+\S*=@)|Invoke-(WebRequest|RestMethod)\s+.*-InFile\s)</field>
    <description>[DL-WIN-016] Possible data EXFILTRATION with $(win.eventdata.image): $(win.eventdata.commandLine)</description>
    <mitre>
      <id>T1567.002</id>
      <id>T1048</id>
    </mitre>
    <group>exfiltration,</group>
  </rule>

</group>
